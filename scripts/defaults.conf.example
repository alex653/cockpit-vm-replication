# Глобальные значения репликации libvirt ВМ; читается скриптом vm-replicate.
#
# LIBVIRT_URI — куда подключаться. Остальные поля — шаблон (значения по
# умолчанию) для НОВЫХ конфигураций; каждая конфигурация ВМ хранится отдельно
# в /etc/vm-replication/vms.d/<vm>.conf и может переопределить их.

LIBVIRT_URI="qemu:///system"

# Каталог локальных копий по умолчанию (сюда пишет qemu; владелец libvirt-qemu)
STORAGE_ROOT="/var/lib/libvirt/replication"

# Полная копия раз в FULL_EVERY_DAYS дней либо когда инкрементов станет MAX_INCS
FULL_EVERY_DAYS=7
MAX_INCS=48

# Сколько последних цепочек хранить (локально и на удалённом)
KEEP_CHAINS=2

# Таймаут одного backup-задания, сек
BACKUP_TIMEOUT=14400

# 1 = проверять результат qemu-img check перед отправкой
QEMU_IMG_CHECK=1
