# Конфигурация репликации libvirt ВМ; читается скриптом /usr/local/sbin/vm-replicate

# Список ВМ через пробел
VMS="win_sn"

# Куда зеркалировать по rsync/ssh, формат "user@host:/путь".
# Пусто = хранить только локальную копию в STORAGE_ROOT.
REMOTE_TARGET=""

# Дополнительные опции ssh (нестандартный порт: -p 2222 и т.п.)
REMOTE_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=30"

# Каталог локальных копий (сюда же пишет qemu, поэтому владелец libvirt-qemu)
STORAGE_ROOT="/mnt/dd/replication"

# Полная копия — раз в FULL_EVERY_DAYS дней либо когда инкрементов станет MAX_INCS
FULL_EVERY_DAYS=7
MAX_INCS=48

# Сколько последних цепочек хранить (локально и на удалённом)
KEEP_CHAINS=2

# Таймаут одного backup-задания, сек
BACKUP_TIMEOUT=14400

# 1 = проверять результат qemu-img check перед отправкой
QEMU_IMG_CHECK=1
