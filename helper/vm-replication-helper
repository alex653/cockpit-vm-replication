#!/usr/bin/env python3
"""vm-replication-helper — privileged JSON API used by the Cockpit UI.

Invoked as:
    vm-replication-helper <subcommand> [args]

Every subcommand prints a single JSON object to stdout and exits 0 on
success. On failure it prints a human-readable message to stderr and
exits non-zero.

The helper is meant to be run as root (via `sudo -n` granted to the
helper path only, or via pkexec). It deliberately does NOT accept
arbitrary commands: every argument is validated, paths are confined to
the configured storage roots, and external programs are spawned with
argument lists (never through a shell).

Configuration model: one replication configuration per VM.
    /etc/vm-replication/defaults.conf   global LIBVIRT_URI + seed values
    /etc/vm-replication/vms.d/<vm>.conf one profile (VM + its settings)
    /etc/vm-replication/keys/<vm>       that profile's ssh key pair

Subcommands:
    status                       full JSON snapshot for the dashboard
    defaults-get                 parsed defaults.conf
    defaults-set                 merge JSON (stdin) into defaults.conf
    entry-list                   list configured VM names
    entry-get VM                 one entry (merged with defaults)
    entry-save                   create/overwrite one entry (JSON on stdin)
    entry-delete VM              remove an entry's config file (keeps chains)
    key-get VM                   info about a profile's ssh key
    key-generate VM              create/regenerate that profile's key pair
    key-delete VM                remove that profile's key pair
    remote-check VM              probe the entry's remote access (JSON on
                                 stdin may override {remote_target, ssh_opts})
    hostkey-scan VM              list remote host keys + fingerprints
    hostkey-accept VM            append those keys to root's known_hosts
    run [--vm NAME]              start vm-replicate detached (one VM or all)
    run-status                   is a manual run active + its log tail
    restore-start VM CHAIN TARGET assemble chain into TARGET (detached)
    restore-status               restore job status + log tail
    chain-delete VM CHAIN        delete one stored chain
    timer ACTION                 start|stop|restart|enable|disable the timer
    logs [N]                     last N journal lines (default 300)
"""

import fcntl
import json
import os
import re
import shlex
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

__version__ = "2.1.0"

CONFIG_DIR = Path("/etc/vm-replication")
DEFAULTS_PATH = CONFIG_DIR / "defaults.conf"
VMSD = CONFIG_DIR / "vms.d"
KEYS_DIR = CONFIG_DIR / "keys"
LEGACY_PATH = CONFIG_DIR / "vms.conf"

RUN_DIR = Path("/run")
LOCK_FILE = RUN_DIR / "lock" / "vm-replication.lock"
MANUAL_PID = RUN_DIR / "vm-replication-manual.pid"
MANUAL_LOG = RUN_DIR / "vm-replication-manual.log"
RESTORE_PID = RUN_DIR / "vm-replication-restore.pid"
RESTORE_LOG = RUN_DIR / "vm-replication-restore.log"
REPLICATE = shutil.which("vm-replicate") or "/usr/local/sbin/vm-replicate"
RESTORE = shutil.which("vm-restore") or "/usr/local/sbin/vm-restore"

VM_RE = re.compile(r"^[A-Za-z0-9._+-]{1,64}$")
CHAIN_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
TARGET_RE = re.compile(r"^([^@\s]{1,128})@([^:\s]{1,253}):(/.{0,499}|.{1,500})$")
HOST_RE = re.compile(r"^[A-Za-z0-9._-]{1,253}$")

# key: (type, validator) — the only keys an entry may set
ENTRY_KEYS = {
    "VM": ("vm", None),
    "REMOTE_TARGET": ("str", lambda v: v == "" or TARGET_RE.match(v)),
    "REMOTE_SSH_OPTS": ("str", None),
    "SSH_KEY": ("abs-path", None),
    "STORAGE_ROOT": ("abs-path", None),
    "FULL_EVERY_DAYS": ("int", (1, 3650)),
    "MAX_INCS": ("int", (1, 10000)),
    "KEEP_CHAINS": ("int", (1, 100)),
    "BACKUP_TIMEOUT": ("int", (60, 604800)),
    "QEMU_IMG_CHECK": ("int", (0, 1)),
    "ACTIVE": ("int", (0, 1)),
    "MODE": ("str", lambda v: v in ("schedule", "manual")),
}

# human-readable hint per key for validation errors (keys with custom validators)
VALIDATOR_HINTS = {"MODE": "expected schedule or manual"}
# keys defaults.conf may hold (global + seed values for new profiles)
DEFAULTS_KEYS = {
    "LIBVIRT_URI": ("str", None),
    "STORAGE_ROOT": ("abs-path", None),
    "FULL_EVERY_DAYS": ("int", (1, 3650)),
    "MAX_INCS": ("int", (1, 10000)),
    "KEEP_CHAINS": ("int", (1, 100)),
    "BACKUP_TIMEOUT": ("int", (60, 604800)),
    "QEMU_IMG_CHECK": ("int", (0, 1)),
}

INT_DEFAULTS = {"FULL_EVERY_DAYS": 7, "MAX_INCS": 48, "KEEP_CHAINS": 2,
                "BACKUP_TIMEOUT": 14400, "QEMU_IMG_CHECK": 1, "ACTIVE": 1}
STR_DEFAULTS = {"LIBVIRT_URI": "qemu:///system", "STORAGE_ROOT":
                "/var/lib/libvirt/replication", "REMOTE_TARGET": "",
                "REMOTE_SSH_OPTS": "-o BatchMode=yes -o ConnectTimeout=30",
                "SSH_KEY": "", "MODE": "schedule"}


def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def out(obj):
    json.dump(obj, sys.stdout, ensure_ascii=False, default=str)
    print()
    sys.exit(0)


def run_cmd(argv, timeout=30):
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout)


def run_cmd_in(argv, stdin_text, timeout=15):
    return subprocess.run(argv, input=stdin_text, capture_output=True,
                          text=True, timeout=timeout)


# --------------------------------------------------------------- parsing ---

def parse_kv(path):
    """Parse a shell-ish KEY=VALUE file into a dict."""
    cfg = {}
    try:
        text = path.read_text()
    except OSError:
        return cfg
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r"^([A-Z_]+)=(.*)$", line)
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        if len(val) >= 2 and val[0] == '"' and val[-1] == '"':
            val = val[1:-1]
        cfg[key] = val
    return cfg


def get_val(cfg, key):
    return cfg.get(key, INT_DEFAULTS.get(key, STR_DEFAULTS.get(key, "")))


def read_defaults():
    return parse_kv(DEFAULTS_PATH)


def entry_path(vm):
    return VMSD / f"{vm}.conf"


def list_entry_vms():
    if not VMSD.is_dir():
        return []
    vms = []
    for p in sorted(VMSD.glob("*.conf")):
        vm = parse_kv(p).get("VM") or p.stem
        if vm:
            vms.append(vm)
    return vms


def read_entry(vm):
    """Entry settings merged over defaults (for display)."""
    d = read_defaults()
    e = parse_kv(entry_path(vm))
    merged = {k: get_val({**d, **e}, k) for k in ENTRY_KEYS}
    merged["VM"] = vm
    return merged


def entry_root(cfg):
    return os.path.normpath(get_val(cfg, "STORAGE_ROOT") or
                            STR_DEFAULTS["STORAGE_ROOT"])


def key_path(vm):
    return KEYS_DIR / vm


# ------------------------------------------------------------- validate ---

def validate_value(key, raw, schema):
    kind = schema[key][0]
    if kind == "vm":
        v = str(raw or "").strip()
        if not VM_RE.match(v):
            fail(f"{key}: invalid VM name {v!r}")
        return v
    if kind == "int":
        try:
            v = int(raw)
        except (TypeError, ValueError):
            fail(f"{key}: expected an integer, got {raw!r}")
        lo, hi = schema[key][1]
        if not lo <= v <= hi:
            fail(f"{key}: {v} is out of range {lo}..{hi}")
        return str(v)
    if kind == "abs-path":
        v = str(raw or "").strip()
        if v and not v.startswith("/"):
            fail(f"{key}: must be an absolute path")
        if any(c in v for c in "\n\r\"'"):
            fail(f"{key}: invalid characters")
        return v
    v = str(raw if raw is not None else "").strip()
    if "\n" in v or "\r" in v:
        fail(f"{key}: newlines are not allowed")
    validator = schema[key][1]
    if validator and not validator(v):
        fail(f"{key}: invalid value {v!r} ({VALIDATOR_HINTS.get(key, 'expected user@host:/path')})")
    return v


def write_kv_file(path, values, header, order):
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = [header, ""]
    for k in order:
        if k in values:
            lines.append(f'{k}="{values[k]}"')
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix="." + path.name + ".")
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines).rstrip("\n") + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


# ----------------------------------------------------------------- virsh ---

def virsh(cfg, *args, timeout=30):
    uri = get_val(cfg, "LIBVIRT_URI") or "qemu:///system"
    return run_cmd(["virsh", "-c", uri, *args], timeout=timeout)


def list_all_vms(cfg):
    r = virsh(cfg, "list", "--all", "--name")
    return [l.strip() for l in r.stdout.splitlines() if l.strip()] if r.returncode == 0 else []


def vm_state(cfg, vm):
    r = virsh(cfg, "domstate", vm)
    return r.stdout.strip() if r.returncode == 0 else "unknown"


def vm_checkpoints(cfg, vm):
    r = virsh(cfg, "checkpoint-list", vm, "--name")
    return [l.strip() for l in r.stdout.splitlines() if l.strip()] if r.returncode == 0 else []


# ---------------------------------------------------------------- status ---

def iso(ts):
    return datetime.fromtimestamp(ts, tz=timezone.utc).astimezone().isoformat(timespec="seconds")


def scan_chains(root, vm):
    chains = []
    vm_dir = os.path.join(root, vm)
    if not os.path.isdir(vm_dir):
        return chains
    for entry in sorted(os.listdir(vm_dir)):
        d = os.path.join(vm_dir, entry)
        if not os.path.isdir(d):
            continue
        fulls, incs, inc_bytes = [], 0, 0
        for f in os.listdir(d):
            fp = os.path.join(d, f)
            try:
                st = os.lstat(fp)
            except OSError:
                continue
            if not stat.S_ISREG(st.st_mode):
                continue
            if f.startswith("full-") and f.endswith(".qcow2"):
                fulls.append({"file": f, "size": st.st_size, "mtime": iso(st.st_mtime)})
            elif f.startswith("inc-") and f.endswith(".qcow2"):
                incs += 1
                inc_bytes += st.st_size
        full_bytes = sum(f["size"] for f in fulls)
        times = [f["mtime"] for f in fulls]
        if incs:
            newest_inc = max(
                (os.lstat(os.path.join(d, f)).st_mtime for f in os.listdir(d)
                 if f.startswith("inc-") and f.endswith(".qcow2")), default=0)
            times.append(iso(newest_inc))
        chains.append({
            "name": entry,
            "kind": "cold" if entry.startswith("cold-") else "chain",
            "created": iso(os.lstat(d).st_mtime),
            "full_files": fulls,
            "full_bytes": full_bytes,
            "inc_count": incs,
            "inc_bytes": inc_bytes,
            "total_bytes": full_bytes + inc_bytes,
            "last_backup": max(times) if times else None,
            "has_domain_xml": os.path.isfile(os.path.join(d, "domain.xml")),
        })
    chains.sort(key=lambda c: c["created"], reverse=True)
    return chains


def parse_journal(lines):
    runs, cur = [], None
    marker = re.compile(r"^(\d{4}-\d{2}-\d{2}[T ][0-9:]+).*== (\S+) ==")
    for line in lines:
        m = marker.match(line)
        if m:
            cur = {"ts": m.group(1), "vm": m.group(2), "status": "running",
                   "mode": None, "messages": []}
            runs.append(cur)
            continue
        if cur is None:
            continue
        if "полная копия" in line:
            cur["mode"] = "full"
        elif "инкремент" in line:
            cur["mode"] = cur["mode"] or "increment"
        elif "холодная копия" in line or "холодную копию" in line:
            cur["mode"] = cur["mode"] or "cold"
        if "ОШИБКА" in line or "ERROR" in line:
            cur["status"] = "error"
        if "rsync не удался" in line and cur["status"] != "error":
            cur["status"] = "warning"
        cur["messages"].append(line.split("] ", 1)[-1].strip())
        if line.rstrip().endswith("готово") and cur["status"] == "running":
            cur["status"] = "ok"
    return runs


def journalctl(cfg, lines=300):
    r = run_cmd(["journalctl", "-t", "vm-replication", "-n", str(lines),
                 "-o", "short-iso", "--no-pager"])
    return r.stdout.splitlines() if r.stdout else []


def timer_info():
    def show(unit, props):
        r = run_cmd(["systemctl", "show", unit] + [f"--property={p}" for p in props])
        res = {}
        if r.returncode == 0:
            for line in r.stdout.splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    res[k] = v
        return res

    t = show("vm-replication.timer", ["ActiveState", "UnitFileState",
                                      "NextElapseUSecRealtime", "LastTriggerUSec"])
    s = show("vm-replication.service", ["Result", "ExecMainStatus", "ActiveEnterTimestamp"])
    return {
        "installed": bool(t),
        "active": t.get("ActiveState") == "active",
        "unit_file_state": t.get("UnitFileState", ""),
        "next_elapse": t.get("NextElapseUSecRealtime", "") or None,
        "last_trigger": t.get("LastTriggerUSec", "") or None,
        "service_result": s.get("Result", ""),
        "service_last_status": s.get("ExecMainStatus", ""),
        "service_last_start": s.get("ActiveEnterTimestamp", "") or None,
    }


def tail_file(path, n=60):
    try:
        return path.read_text(errors="replace").splitlines()[-n:]
    except OSError:
        return []


def pid_alive(pidfile):
    try:
        pid = int(pidfile.read_text().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def replication_busy():
    try:
        fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(fd, fcntl.LOCK_UN)
            return False
        finally:
            os.close(fd)
    except OSError:
        return True


def key_info(vm):
    kp = key_path(vm)
    pub = Path(str(kp) + ".pub")
    exists = kp.is_file() and pub.is_file()
    info = {"path": str(kp), "exists": exists, "used_automatically": exists}
    if exists:
        info["public_key"] = pub.read_text().strip()
        r = run_cmd(["ssh-keygen", "-lf", str(pub)])
        info["fingerprint"] = r.stdout.strip() if r.returncode == 0 else None
        info["generated_at"] = iso(kp.stat().st_mtime)
    return info


def build_entry(vm, defaults, all_vms, last_by_vm):
    cfg = read_entry(vm)
    root = entry_root(cfg)
    chains = scan_chains(root, vm)
    active = next((c["name"] for c in chains if c["kind"] == "chain" and c["full_files"]), None)
    state = vm_state(defaults, vm) if vm in all_vms else "missing"
    cps = vm_checkpoints(defaults, vm) if state == "running" else []
    full_age_days, inc_count = None, 0
    if active:
        act = next(c for c in chains if c["name"] == active)
        full_mtime = max((f["mtime"] for f in act["full_files"]), default=None)
        if full_mtime:
            dt = datetime.fromisoformat(full_mtime)
            full_age_days = (datetime.now(dt.tzinfo) - dt).days
        inc_count = act["inc_count"]
    next_action = None
    if state == "running":
        try:
            if (full_age_days is not None and
                    full_age_days >= int(get_val(cfg, "FULL_EVERY_DAYS"))) or \
                    inc_count >= int(get_val(cfg, "MAX_INCS")):
                next_action = "full"
            else:
                next_action = "increment"
        except (TypeError, ValueError):
            next_action = None
    st = os.statvfs(root) if os.path.isdir(root) else None
    return {
        "vm": vm, "name": vm,
        "in_config": entry_path(vm).is_file(),
        "config": cfg,
        "key": key_info(vm),
        "state": state,
        "chains": chains,
        "active_chain": active,
        "checkpoints": cps,
        "full_age_days": full_age_days,
        "next_action": next_action,
        "last_run": last_by_vm.get(vm),
        "storage": {"root": root, "exists": st is not None,
                    "free_bytes": st.f_bavail * st.f_frsize if st else None,
                    "total_bytes": st.f_blocks * st.f_frsize if st else None},
    }


def cmd_status():
    defaults = read_defaults()
    all_vms = list_all_vms(defaults)
    entry_vms = list_entry_vms()

    # VMs that have chains on disk but no entry (orphaned) — scan default root
    disk_vms = set()
    for root in {entry_root(read_entry(v)) for v in entry_vms} | {entry_root(defaults)}:
        if os.path.isdir(root):
            try:
                disk_vms |= {d for d in os.listdir(root) if os.path.isdir(os.path.join(root, d))}
            except OSError:
                pass
    vms = list(dict.fromkeys(entry_vms + sorted(disk_vms - set(entry_vms))))

    runs = parse_journal(journalctl(defaults, 500))
    last_by_vm = {}
    for run in runs:
        last_by_vm[run["vm"]] = run

    entries = [build_entry(vm, defaults, all_vms, last_by_vm) for vm in vms]

    droot = entry_root(defaults)
    dst = os.statvfs(droot) if os.path.isdir(droot) else None
    busy = replication_busy()
    out({
        "helper_version": __version__,
        "hostname": socket.gethostname(),
        "now": datetime.now().astimezone().isoformat(timespec="seconds"),
        "timer": timer_info(),
        "defaults": defaults,
        "storage": {"root": droot, "exists": dst is not None,
                    "free_bytes": dst.f_bavail * dst.f_frsize if dst else None,
                    "total_bytes": dst.f_blocks * dst.f_frsize if dst else None},
        "entries": entries,
        "vms": entries,
        "all_vms": all_vms,
        "runs": runs[-15:],
        "busy": busy,
        "manual_run": {"running": busy or pid_alive(MANUAL_PID) is not None,
                       "log_tail": tail_file(MANUAL_LOG)},
        "restore": {"running": pid_alive(RESTORE_PID) is not None,
                    "log_tail": tail_file(RESTORE_LOG)},
        "scripts": {"vm-replicate": os.path.exists(REPLICATE),
                    "vm-restore": os.path.exists(RESTORE)},
    })


# ------------------------------------------------------- defaults & entry ---

def cmd_defaults_set(payload):
    if not isinstance(payload, dict):
        fail("expected a JSON object on stdin")
    unknown = set(payload) - set(DEFAULTS_KEYS)
    if unknown:
        fail(f"unknown defaults keys: {', '.join(sorted(unknown))}")
    cur = read_defaults()
    merged = {**cur, **{k: validate_value(k, v, DEFAULTS_KEYS) for k, v in payload.items()}}
    write_kv_file(DEFAULTS_PATH, merged,
                  "# Глобальные значения репликации (LIBVIRT_URI + шаблон для новых конфигураций)",
                  list(DEFAULTS_KEYS))
    out({"ok": True, "defaults": read_defaults()})


def cmd_entry_save(payload):
    if not isinstance(payload, dict):
        fail("expected a JSON object on stdin")
    vm = str(payload.get("vm") or "").strip()
    if not VM_RE.match(vm):
        fail(f"invalid VM name {vm!r}")
    field_map = {"remote_target": "REMOTE_TARGET", "ssh_opts": "REMOTE_SSH_OPTS",
                 "ssh_key": "SSH_KEY", "storage_root": "STORAGE_ROOT",
                 "full_every_days": "FULL_EVERY_DAYS", "max_incs": "MAX_INCS",
                 "keep_chains": "KEEP_CHAINS", "backup_timeout": "BACKUP_TIMEOUT",
                 "qemu_img_check": "QEMU_IMG_CHECK",
                 "active": "ACTIVE", "mode": "MODE"}
    values = {"VM": vm}
    for jkey, ckey in field_map.items():
        if jkey in payload:
            values[ckey] = validate_value(ckey, payload[jkey], ENTRY_KEYS)
    # partial saves (e.g. only the activity toggle from the table) must keep
    # the rest of the existing profile instead of falling back to defaults
    existing = parse_kv(entry_path(vm)) if entry_path(vm).is_file() else {}
    # ensure a key path for this profile (file may not exist yet — that's fine)
    if not values.get("SSH_KEY"):
        values["SSH_KEY"] = existing.get("SSH_KEY") or str(key_path(vm))
    defaults = read_defaults()
    for k in ("STORAGE_ROOT", "FULL_EVERY_DAYS", "MAX_INCS", "KEEP_CHAINS",
              "BACKUP_TIMEOUT", "QEMU_IMG_CHECK"):
        values.setdefault(k, existing.get(k, get_val(defaults, k)))
    values.setdefault("REMOTE_TARGET", existing.get("REMOTE_TARGET", ""))
    values.setdefault("REMOTE_SSH_OPTS",
                      existing.get("REMOTE_SSH_OPTS",
                                   get_val(defaults, "REMOTE_SSH_OPTS")
                                   if "REMOTE_SSH_OPTS" in defaults
                                   else STR_DEFAULTS["REMOTE_SSH_OPTS"]))
    values.setdefault("ACTIVE", existing.get("ACTIVE", "1"))
    values.setdefault("MODE", existing.get("MODE", "schedule"))
    write_kv_file(entry_path(vm), values,
                  f"# Конфигурация репликации ВМ {vm}", list(ENTRY_KEYS))
    out({"ok": True, "entry": read_entry(vm), "key": key_info(vm)})


def cmd_entry_delete(vm):
    if not VM_RE.match(vm):
        fail(f"invalid VM name {vm!r}")
    p = entry_path(vm)
    if not p.is_file():
        fail(f"no configuration for {vm!r}")
    os.remove(p)
    out({"ok": True, "removed": str(p),
         "note": "chains and the ssh key were kept on disk"})


# ---------------------------------------------------------- remote-check ---

def resolve_target_opts(vm, payload):
    """Resolve {target, opts, key_path} for a VM from the entry, allowing the
    UI to override target/opts with unsaved form values. Emits JSON on error."""
    payload = payload if isinstance(payload, dict) else {}
    cfg = read_entry(vm)
    target = str(payload.get("remote_target") if payload.get("remote_target") is not None
                 else get_val(cfg, "REMOTE_TARGET")).strip()
    opts = str(payload.get("ssh_opts") if payload.get("ssh_opts") is not None
               else get_val(cfg, "REMOTE_SSH_OPTS")).strip()
    return target, opts, key_path(vm)


def parse_target_opts(target, opts):
    m = TARGET_RE.match(target)
    if not m:
        out({"ok": False, "target": target, "checks": [{
            "name": "Target format", "ok": False,
            "detail": "expected user@host:/absolute/path (no port — put it into SSH options as -p <port>)",
        }]})
    user, host, path = m.groups()
    try:
        opt_list = shlex.split(opts)
    except ValueError as exc:
        out({"ok": False, "target": target, "checks": [{
            "name": "SSH options", "ok": False, "detail": f"cannot parse: {exc}",
        }]})
    port = None
    for i, o in enumerate(opt_list):
        if o == "-p" and i + 1 < len(opt_list):
            port = opt_list[i + 1]
        elif o.startswith("-p") and len(o) > 2:
            port = o[2:]
    return {"target": target, "user": user, "host": host, "path": path,
            "opt_list": opt_list, "port": port}


def auth_hint(stderr, key_path=None):
    s = (stderr or "").lower()
    if "host key verification failed" in s:
        return ("The remote host key is not known to root yet. Use the "
                "\"Accept host key\" button below (verify the fingerprints "
                "first if you can), or run the ssh command once in a terminal "
                "and confirm the key.")
    if "permission denied" in s:
        if key_path:
            return ("Key authentication was rejected. Append the profile's "
                    f"public key ({key_path}.pub) to ~/.ssh/authorized_keys of "
                    "the target user on the remote host, or run:  "
                    f"sudo ssh-copy-id -i {key_path}.pub <same ssh options> user@host")
        return ("Key authentication was rejected. Install root's key on the "
                "remote host:  sudo ssh-copy-id <same ssh options> user@host")
    if "connection refused" in s:
        return ("Connection refused — is sshd running there and is the port "
                "correct (see the SSH options field, -p <port>)?")
    if "timed out" in s or "connection timed out" in s:
        return "Connection timed out — check the address, port and firewall."
    if "name or service not known" in s or "could not resolve" in s:
        return ("The host name could not be resolved. Note: name resolution "
                "happens for root, aliases belong into /root/.ssh/config.")
    return None


def cmd_remote_check(vm, payload):
    target, opts, kp = resolve_target_opts(vm, payload)
    t = parse_target_opts(target, opts)
    user, host, path = t["user"], t["host"], t["path"]
    opt_list, port = t["opt_list"], t["port"]
    checks = []

    def ssh_argv(remote_command):
        extra = []
        if kp.is_file():
            extra = ["-i", str(kp), "-o", "IdentitiesOnly=yes"]
        return ["ssh", *opt_list, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                *extra, f"{user}@{host}", remote_command]

    r = run_cmd(ssh_argv("true"), timeout=25)
    checks.append({"name": "SSH connection and key auth", "ok": r.returncode == 0,
                   "detail": "connected, public key accepted" if r.returncode == 0
                             else (r.stderr.strip().splitlines() or ["ssh failed"])[-1][:200]})
    hint = None if r.returncode == 0 else auth_hint(r.stderr, kp if kp.is_file() else None)
    if r.returncode != 0:
        out({"ok": False, "target": target, "port": port, "checks": checks, "hint": hint})

    q = shlex.quote
    probe = (f'p={q(path)}; d=0; w=0; rs=0; v="-"; '
             '[ -d "$p" ] && d=1; '
             '{ [ -w "$p" ] || { [ ! -e "$p" ] && [ -w "$(dirname "$p")" ]; }; } && w=1; '
             'command -v rsync >/dev/null 2>&1 && { rs=1; v=$(rsync --version 2>/dev/null | head -n 1); }; '
             'echo "d=$d w=$w rs=$rs"; echo "v=$v"')
    r2 = run_cmd(ssh_argv(probe), timeout=30)
    flags, rsync_version = {}, "-"
    if r2.returncode == 0:
        for line in r2.stdout.splitlines():
            if line.startswith("d="):
                flags = dict(kv.split("=", 1) for kv in line.split() if "=" in kv)
            elif line.startswith("v="):
                rsync_version = line[2:][:120]
    if not flags:
        checks.append({"name": "Remote probe", "ok": False,
                       "detail": (r2.stderr.strip().splitlines() or ["probe failed"])[-1][:200]})
        out({"ok": False, "target": target, "port": port, "checks": checks})
    exists, writable = flags.get("d") == "1", flags.get("w") == "1"
    checks.append({"name": "Target path", "ok": writable,
                   "detail": (f"{path} — exists and writable" if exists and writable else
                              f"{path} — writable (will be created on first sync)" if writable else
                              f"{path} — missing and parent not writable")})
    has_rsync = flags.get("rs") == "1"
    checks.append({"name": "rsync on remote host", "ok": has_rsync,
                   "detail": rsync_version if has_rsync else "rsync not found in PATH — install it on the remote host"})
    out({"ok": writable and has_rsync, "target": target, "port": port, "checks": checks})


# ----------------------------------------------------------- host keys ---

KNOWN_HOSTS = Path("/root/.ssh/known_hosts")


def scan_host_keys(t):
    host = t["host"]
    if not HOST_RE.match(host):
        out({"ok": False, "host": host,
             "detail": "host name contains characters that cannot be scanned safely"})
    argv = ["ssh-keyscan"]
    if t["port"]:
        argv += ["-p", str(t["port"])]
    argv.append(host)
    r = run_cmd(argv, timeout=25)
    lines = [ln for ln in r.stdout.splitlines() if ln.strip() and not ln.startswith("#")]
    if not lines:
        out({"ok": False, "host": host, "port": t["port"],
             "detail": "no host keys returned — is sshd reachable on that port?"})
    fp = run_cmd_in(["ssh-keygen", "-l", "-f", "-"], "\n".join(lines) + "\n")
    fingerprints = fp.stdout.splitlines() if fp.returncode == 0 else []
    keys = []
    for i, ln in enumerate(lines):
        parts = ln.split()
        keys.append({"hostspec": parts[0] if parts else "",
                     "type": parts[1] if len(parts) > 2 else "?",
                     "fingerprint": fingerprints[i] if i < len(fingerprints) else ln[:120]})
    return lines, keys


def known_hostspecs():
    existing = set()
    if KNOWN_HOSTS.is_file():
        for ln in KNOWN_HOSTS.read_text().splitlines():
            parts = ln.split()
            if len(parts) >= 2:
                existing.add((parts[0], parts[1]))
    return existing


def cmd_hostkey_scan(vm, payload):
    target, opts, _ = resolve_target_opts(vm, payload)
    t = parse_target_opts(target, opts)
    _, keys = scan_host_keys(t)
    existing = known_hostspecs()
    for k in keys:
        k["already_known"] = (k["hostspec"], k["type"]) in existing
    out({"ok": True, "host": t["host"], "port": t["port"], "keys": keys})


def cmd_hostkey_accept(vm, payload):
    target, opts, _ = resolve_target_opts(vm, payload)
    t = parse_target_opts(target, opts)
    lines, keys = scan_host_keys(t)
    existing = known_hostspecs()
    to_add = [ln for ln, k in zip(lines, keys) if (k["hostspec"], k["type"]) not in existing]
    if not to_add:
        out({"ok": True, "added": 0, "keys": keys, "detail": "all host keys are already trusted"})
    KNOWN_HOSTS.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(KNOWN_HOSTS.parent, 0o700)
    prefix = ""
    if KNOWN_HOSTS.is_file() and KNOWN_HOSTS.read_text() and not KNOWN_HOSTS.read_text().endswith("\n"):
        prefix = "\n"
    with open(KNOWN_HOSTS, "a") as f:
        f.write(prefix + "\n".join(to_add) + "\n")
    os.chmod(KNOWN_HOSTS, 0o600)
    out({"ok": True, "added": len(to_add), "keys": keys})


# --------------------------------------------------------------- ssh key ---

def cmd_key_get(vm):
    out(key_info(vm))


def cmd_key_generate(vm):
    if not VM_RE.match(vm):
        fail(f"invalid VM name {vm!r}")
    kp = key_path(vm)
    pub = Path(str(kp) + ".pub")
    KEYS_DIR.mkdir(parents=True, exist_ok=True)
    for p in (kp, pub):
        try:
            os.remove(p)
        except FileNotFoundError:
            pass
    comment = f"vm-replication@{socket.gethostname()}/{vm} {datetime.now().astimezone():%Y-%m-%d}"
    r = run_cmd(["ssh-keygen", "-t", "ed25519", "-N", "", "-q", "-C", comment, "-f", str(kp)], timeout=30)
    if r.returncode != 0 or not pub.is_file():
        fail(r.stderr.strip() or "ssh-keygen failed")
    os.chmod(kp, 0o600)
    out(key_info(vm))


def cmd_key_delete(vm):
    kp = key_path(vm)
    removed = []
    for p in (kp, Path(str(kp) + ".pub")):
        if p.exists():
            os.remove(p)
            removed.append(str(p))
    out({"ok": True, "removed": removed, "key": key_info(vm)})


# ------------------------------------------------------------------ run ---

def spawn_detached(argv, pidfile, logfile, extra_env=None):
    if pid_alive(pidfile):
        fail("another job started by the UI is still running")
    if replication_busy():
        fail("replication is already running (timer or another manual run)")
    env = dict(os.environ)
    if extra_env:
        env.update(extra_env)
    log = open(logfile, "w")
    proc = subprocess.Popen(argv, stdout=log, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL, start_new_session=True, env=env)
    pidfile.write_text(str(proc.pid))
    return proc.pid


def cmd_run(vm=None, force=None):
    if not os.path.exists(REPLICATE):
        fail(f"{REPLICATE} not found — is the replication stack installed?")
    if force is not None and force not in ("full", "incremental"):
        fail(f"invalid copy type {force!r}")
    if force and not vm:
        fail("copy type requires --vm NAME")
    argv = [REPLICATE]
    if vm:
        if not VM_RE.match(vm):
            fail(f"invalid VM name {vm!r}")
        if vm not in list_all_vms(read_defaults()):
            fail(f"VM {vm!r} does not exist")
        argv.append(vm)
        if force:
            argv.append(f"--{force}")
    # an explicit "run now" from the UI also runs MODE=manual VMs; the
    # systemd timer path calls vm-replicate without this variable
    pid = spawn_detached(argv, MANUAL_PID, MANUAL_LOG,
                         extra_env={} if vm else {"VM_REPLICATE_MANUAL": "1"})
    out({"ok": True, "pid": pid})


def cmd_run_status():
    pid = pid_alive(MANUAL_PID)
    busy = replication_busy()
    out({"running": busy or pid is not None, "pid": pid, "lock_busy": busy,
         "log_tail": tail_file(MANUAL_LOG)})


# -------------------------------------------------------------- restore ---

def validated_chain_path(vm, chain):
    if not VM_RE.match(vm):
        fail(f"invalid VM name {vm!r}")
    if not CHAIN_RE.match(chain):
        fail(f"invalid chain name {chain!r}")
    root = Path(entry_root(read_entry(vm))).resolve()
    chain_dir = root / vm / chain
    if not chain_dir.is_dir():
        fail(f"chain directory not found: {chain_dir}")
    real = chain_dir.resolve()
    if root not in real.parents:
        fail("path escapes the storage root — refused")
    return real


def cmd_restore_start(vm, chain, target):
    chain_dir = validated_chain_path(vm, chain)
    if not os.path.exists(RESTORE):
        fail(f"{RESTORE} not found — is the replication stack installed?")
    target = os.path.normpath(str(target or ""))
    if not target.startswith("/") or target.endswith("/"):
        fail("target must be an absolute file path")
    if os.path.exists(target):
        fail(f"target already exists: {target} (remove it first)")
    parent = os.path.dirname(target)
    if not os.path.isdir(parent):
        fail(f"target directory does not exist: {parent}")
    total = sum(c["total_bytes"] for c in scan_chains(entry_root(read_entry(vm)), vm)
                if c["name"] == chain)
    st = os.statvfs(parent)
    free = st.f_bavail * st.f_frsize
    if total and free < total:
        fail(f"not enough space on {parent}: need ~{total >> 30} GiB, free {free >> 30} GiB")
    pid = spawn_detached([RESTORE, str(chain_dir), target], RESTORE_PID, RESTORE_LOG)
    out({"ok": True, "pid": pid, "target": target})


def cmd_restore_status():
    pid = pid_alive(RESTORE_PID)
    out({"running": pid is not None, "pid": pid, "log_tail": tail_file(RESTORE_LOG)})


# ---------------------------------------------------------- chain-delete ---

def cmd_chain_delete(vm, chain):
    if replication_busy():
        fail("replication is running — try again when it finishes")
    chain_dir = validated_chain_path(vm, chain)
    cold = chain_dir.name.startswith("cold-")
    shutil.rmtree(chain_dir)
    if not cold:
        defaults = read_defaults()
        for cp in vm_checkpoints(defaults, vm):
            if f"-{chain}-" in cp:
                virsh(defaults, "checkpoint-delete", vm, cp)
    out({"ok": True})


# ----------------------------------------------------------------- misc ---

def cmd_timer(action):
    if action not in ("start", "stop", "restart", "enable", "disable"):
        fail(f"unknown action {action!r}")
    r = run_cmd(["systemctl", action, "vm-replication.timer"])
    if r.returncode != 0:
        fail(r.stderr.strip() or f"systemctl {action} failed")
    out({"ok": True, "timer": timer_info()})


def cmd_logs(n):
    try:
        n = max(1, min(int(n), 5000))
    except ValueError:
        fail("lines must be an integer")
    out({"lines": journalctl(read_defaults(), n)})


def _vm_arg(rest):
    if not rest or not VM_RE.match(rest[0]):
        fail("usage: expects a VM name argument")
    return rest[0]


def main():
    args = sys.argv[1:]
    if not args:
        fail(__doc__)
    cmd, rest = args[0], args[1:]
    if cmd == "status":
        cmd_status()
    elif cmd == "defaults-get":
        out({"defaults": read_defaults()})
    elif cmd == "defaults-set":
        cmd_defaults_set(json.load(sys.stdin))
    elif cmd == "entry-list":
        out({"entries": list_entry_vms()})
    elif cmd == "entry-get":
        out({"entry": read_entry(_vm_arg(rest)), "key": key_info(_vm_arg(rest))})
    elif cmd == "entry-save":
        cmd_entry_save(json.load(sys.stdin))
    elif cmd == "entry-delete":
        cmd_entry_delete(_vm_arg(rest))
    elif cmd == "remote-check":
        cmd_remote_check(_vm_arg(rest), json.load(sys.stdin))
    elif cmd == "hostkey-scan":
        cmd_hostkey_scan(_vm_arg(rest), json.load(sys.stdin))
    elif cmd == "hostkey-accept":
        cmd_hostkey_accept(_vm_arg(rest), json.load(sys.stdin))
    elif cmd == "key-get":
        cmd_key_get(_vm_arg(rest))
    elif cmd == "key-generate":
        cmd_key_generate(_vm_arg(rest))
    elif cmd == "key-delete":
        cmd_key_delete(_vm_arg(rest))
    elif cmd == "run":
        rest = list(rest)
        force = None
        if "--full" in rest:
            force = "full"
            rest.remove("--full")
        if "--incremental" in rest:
            if force:
                fail("use --full or --incremental, not both")
            force = "incremental"
            rest.remove("--incremental")
        vm = rest[1] if len(rest) >= 2 and rest[0] == "--vm" else None
        if rest and not (len(rest) == 2 and rest[0] == "--vm"):
            fail("usage: run [--vm NAME] [--full|--incremental]")
        cmd_run(vm, force)
    elif cmd == "run-status":
        cmd_run_status()
    elif cmd == "restore-start":
        if len(rest) != 3:
            fail("usage: restore-start VM CHAIN TARGET")
        cmd_restore_start(*rest)
    elif cmd == "restore-status":
        cmd_restore_status()
    elif cmd == "chain-delete":
        if len(rest) != 2:
            fail("usage: chain-delete VM CHAIN")
        cmd_chain_delete(*rest)
    elif cmd == "timer":
        if len(rest) != 1:
            fail("usage: timer ACTION")
        cmd_timer(rest[0])
    elif cmd == "logs":
        cmd_logs(rest[0] if rest else 300)
    else:
        fail(f"unknown subcommand {cmd!r}")


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception as exc:  # noqa: BLE001 — the helper must always answer cleanly
        fail(f"{type(exc).__name__}: {exc}")
